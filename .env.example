# Koritsu — образец настроек. Скопировать в `.env` рядом с `docker-compose.yml`
# и заполнить два первых поля; остальные можно не трогать.
#
#     cp .env.example .env && $EDITOR .env
#
# Файл `.env` в репозиторий не кладётся (решение владельца §7: «секреты — `.env`
# на хосте вне репозитория»), и `.gitignore` про это знает. Разворачивает его
# docker compose; служба сама `.env` не читает — она видит только окружение
# (`Settings.from_env`), и второй читатель того же файла разошёлся бы с первым
# на кавычках и переносах.
#
# Правило чтения чисел: пустая строка означает «оставь умолчание», а мусор —
# беду настройки. `KORITSU_TRASH_DAYS=ten` не станет десятью и не станет
# умолчанием: служба откажется подниматься и скажет, чем именно недовольна.
# Умолчания ниже совпадают с теми, что записаны в `packages/api/settings.py`.

# ── обязательное ─────────────────────────────────────────────────────────────

# Том: каталог внутри контейнера, куда смонтирован `koritsu-data`. Умолчания у
# него нет намеренно — иначе служба однажды напишет в слой контейнера, и после
# `docker compose down` работ не станет.
KORITSU_DATA_DIR=/data

# Секрет сервера: им шифруются ключи моделей на диске и подписываются cookie
# сессии. Не короче 32 байт. Сгенерировать:
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Менять его — значит сделать нечитаемыми все сохранённые ключи моделей и
# разлогинить всех.
KORITSU_SECRET=

# ── режим и адреса ───────────────────────────────────────────────────────────

# dev | prod. От него зависит умолчание `KORITSU_TRUST_PROXY` и подробность
# журнала. В бою — prod.
KORITSU_ENV=prod

# Из чего собирается ссылка в письме («подтвердите почту», «сброс пароля»).
# Тот же домен, что в `Caddyfile`. Умолч. http://localhost:8000
KORITSU_BASE_URL=https://koritsu.example

# Верить ли заголовку `X-Forwarded-For`. **За Caddy это обязательно `yes`**:
# иначе все запросы придут с адреса контейнера прокси, и лимит регистраций по
# IP станет лимитом на весь сайт разом. Но и наоборот: с открытым наружу портом
# (dev) это `no`, иначе адрес подделывается одной строкой заголовка.
# Умолч. «да в prod, нет в dev».
KORITSU_TRUST_PROXY=yes

# Где слушать. В compose это сказано аргументом (`serve --host 0.0.0.0`), и
# трогать здесь их незачем; оставлены для запуска руками.
# KORITSU_HOST=127.0.0.1
# KORITSU_PORT=8000

# База. Пусто — SQLite в томе (`$KORITSU_DATA_DIR/koritsu.db`), решение §7.
# Её обязательно забирает резервная копия вместе с файлами: снимок из базы без
# файлов бесполезен ровно так же, как из файлов без базы.
KORITSU_DB_URL=

# ── файлы и квоты (§2) ───────────────────────────────────────────────────────

# 250 МБ на владельца. Считается по каталогам тома, а не файловой системой.
KORITSU_USER_QUOTA_BYTES=262144000

# 10 МБ на один файл. Проверяется до чтения тела в память.
KORITSU_FILE_MAX_BYTES=10485760

# Сколько дней работа лежит в корзине до физической уборки.
KORITSU_TRASH_DAYS=10

# ── аккаунты (§3, §7) ────────────────────────────────────────────────────────

# Сессия с продлением.
KORITSU_SESSION_DAYS=30

# Заслон от массовой регистрации: сколько аккаунтов с одного адреса в сутки.
# Работает только при верном `KORITSU_TRUST_PROXY` — см. выше.
KORITSU_REGISTRATIONS_PER_IP_PER_DAY=5

# ── подпроцесс со схемами (§3) ───────────────────────────────────────────────

# Потолки подпроцесса, жующего чужой исходник (блок-схемы, диаграммы UML).
# Машина, где мегабайт склеенного кода не укладывается в минуту, чинится этой
# строкой, а не пересборкой образа. Имя историческое: первым таким подпроцессом
# был разбор материала, уехавший потом в очередь.
KORITSU_PARSE_TIMEOUT_S=60
KORITSU_PARSE_MEMORY_MB=1024

# ── очередь и воркер (§11) ───────────────────────────────────────────────────

# Слоты: тяжёлых заданий на машину и на одного человека. Решение владельца
# дословно: «2 на машину, 1 на пользователя, остальные ждут в очереди».
KORITSU_JOB_SLOTS=2
KORITSU_JOBS_PER_USER=1

# Как часто воркер заглядывает в таблицу, когда работы нет. Секунды, дробное.
KORITSU_WORKER_POLL_S=1.0

# Потолки одного задания. Полчаса — столько, чтобы отчёт на два десятка тегов с
# медленным поставщиком успел, а зациклившийся обработчик — нет. По этому же
# сроку воркер признаёт чужое задание потерянным.
KORITSU_JOB_TIMEOUT_S=1800
KORITSU_JOB_MEMORY_MB=2048

# Сколько дней хранится законченное задание. Считается от последнего обращения,
# а не от конца работы: отчёт, который открывают раз в месяц, живёт.
KORITSU_JOBS_RETENTION_DAYS=90

# Как часто поток событий (SSE) заглядывает в базу. Секунды, дробное.
KORITSU_SSE_POLL_S=0.5

# Сколько живёт одно соединение потока, прежде чем служба закроет его сама.
# Час — больше самого долгого задания (`KORITSU_JOB_TIMEOUT_S`), поэтому поток
# задания успевает дожить до конца работы; потоку на пользователя это просто
# потолок, после которого браузер переподключается с `Last-Event-ID`.
KORITSU_SSE_MAX_S=3600

# ── модель и расход ──────────────────────────────────────────────────────────

# Месячный потолок расхода плана `free` во внутренних единицах. Число временное
# (§11): владелец решит его вместе с ценами.
KORITSU_FREE_MONTHLY_UNITS=2000000

# Цены наших инструментов в тех же единицах (§12: «расход считается за наши
# инструменты и мощности, а не за токены поставщика»). Списывается цена вида
# при захвате задания воркером; токены поставщика в неё не входят — они живут в
# журнале проекта. **Все числа временные**, до цен подписки; осмысленно в них
# пока только соотношение.
KORITSU_PRICE_PARSE=10
KORITSU_PRICE_EXPORT=20
KORITSU_PRICE_BUILD=50
KORITSU_PRICE_FILL_TAG=100
KORITSU_PRICE_FILL_REPORT=1000
KORITSU_PRICE_AGENT=2000
KORITSU_PRICE_KADAI_RUN=5000
KORITSU_PRICE_KADAI_REWORK=1000
# Проба очереди бесплатна и должна такой остаться: платная проверка «жив ли
# воркер» — это проверка, которую перестают делать.
KORITSU_PRICE_PROBE=0

# Предпросмотров схем в минуту на человека (§12). Единственный тяжёлый маршрут,
# который любой вошедший дёргает без проекта и без роли. Счётчик — в памяти
# процесса, поэтому при двух процессах API настоящий потолок вдвое больше.
KORITSU_PREVIEW_PER_MINUTE=30

# Общие ключи поставщиков — по одному на поставщика, имя пресета заглавными.
# Ими работают те, у кого своего ключа нет; свой ключ пользователь кладёт через
# сайт, и он шифруется `KORITSU_SECRET`. Уезжают эти ключи только в подпроцессы
# заданий, объявивших `needs_secret=True`, и только каналом, не окружением.
# KORITSU_PROVIDER_KEY_DEEPSEEK=
# KORITSU_PROVIDER_KEY_CHATGPT=
