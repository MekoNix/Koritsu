# Koritsu — образец настроек. Скопировать в `.env` рядом с `docker-compose.yml`
# и заполнить два первых поля; остальные можно не трогать.
#
#     cp .env.example .env && $EDITOR .env
#
# Файл `.env` в репозиторий не кладётся — секреты живут на хосте, вне
# репозитория, и `.gitignore` про это знает. Разворачивает его docker compose;
# служба сама `.env` не читает — она видит только окружение
# (`Settings.from_env`), и второй читатель того же файла разошёлся бы с первым
# на кавычках и переносах.
#
# Правило чтения чисел: пустая строка означает «оставь умолчание», а мусор —
# беду настройки. `KORITSU_TRASH_DAYS=ten` не станет десятью и не станет
# умолчанием: служба откажется подниматься и скажет, чем именно недовольна.
# Умолчания ниже совпадают с теми, что записаны в `packages/api/settings.py`.

# ── обязательное ─────────────────────────────────────────────────────────────

# Том: каталог внутри контейнера, куда смонтирован `koritsu-data`. Умолчания у
# него нет намеренно — иначе служба однажды напишет в слой контейнера, и после
# `docker compose down` работ не станет.
KORITSU_DATA_DIR=/data

# Секрет сервера: им шифруются ключи моделей на диске и подписываются cookie
# сессии. Не короче 32 байт. Сгенерировать:
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Менять его — значит сделать нечитаемыми все сохранённые ключи моделей и
# разлогинить всех.
KORITSU_SECRET=

# ── режим и адреса ───────────────────────────────────────────────────────────

# dev | prod. От него зависит умолчание `KORITSU_TRUST_PROXY` и подробность
# журнала. В бою — prod.
KORITSU_ENV=prod

# Адрес сайта целиком, вместе со схемой. Читает его не служба, а
# `docker-compose.yml` → `Caddyfile`. Домена пока нет, сайт живёт на IP машины.
#
#     KORITSU_DOMAIN=http://203.0.113.7      на время теста, без TLS
#     KORITSU_DOMAIN=koritsu.example              когда появится домен
#
# Схема здесь не украшение. С `http://` Caddy не включает автоматический HTTPS
# для этого сайта вовсе; с голым IP — включил бы и выдал самоподписанный
# сертификат, то есть предупреждение браузера на входе. С доменом (без схемы)
# Caddy сам возьмёт сертификат у Let's Encrypt.
#
# Пусто или строки нет — заглушка `http://koritsu.example`: зона `.example`
# зарезервированная, то есть заведомо ничья, и забытая в бою она не уведёт
# запросы к чужому серверу. **Настоящий адрес живёт только здесь и в
# репозиторий не попадает.**
KORITSU_DOMAIN=

# Префикс пути, под которым живёт весь сайт: случайная строка, чтобы адрес не
# нашли перебором и не проиндексировали. С косой в начале и **без** косой на
# конце; пусто — сайт в корне.
#
#     KORITSU_BASE_PATH=/k7f3x9
#
# Сгенерировать:
#
#     python -c "import secrets; print('/' + secrets.token_hex(4))"
#
# Под ним живёт всё разом — и страницы, и `/api`: cookie сессии одна на двоих,
# и разъехавшиеся пути означали бы вход, который не работает. Открывается сайт
# как `http://203.0.113.7/k7f3x9/`; голый префикс без косой Caddy сам уводит на
# адрес с косой, а корень мимо префикса отвечает 404 без подробностей.
#
# `robots.txt` при этом отдаётся в корне и запрещает роботам всё — префикс от
# индексирования не спасает, он спасает от перебора.
#
# **В репозиторий эта строка не попадает.** Как и IP, она живёт только в `.env`.
KORITSU_BASE_PATH=

# Тот же префикс — для сборки сайта, с косой на конце (`/k7f3x9/`), или `/`,
# если префикса нет. Читает его Vite: он вписывает путь в `index.html` и во все
# ссылки на `assets/` **на сборке**, поэтому меняется он только пересборкой
# образа сайта (`docker compose up -d --build`).
#
# Две строки вместо одной — потому что значения разной формы (одна без косой на
# конце, другая с косой), и склеивать их в compose значило бы прятать разницу.
# **Они обязаны сходиться**: разойдясь, они дадут страницу, которая загрузится
# и не заработает, — браузер пойдёт за скриптами не туда.
VITE_BASE_PATH=/

# Из чего собирается ссылка в письме («подтвердите почту», «сброс пароля»).
# Тот же адрес, что выше, **вместе с префиксом пути** и целиком: служба его не
# складывает из кусков, а берёт как есть. С префиксом это выглядит так:
#
#     KORITSU_BASE_URL=http://203.0.113.7/k7f3x9
#
# Умолч. http://localhost:8000
KORITSU_BASE_URL=https://koritsu.example

# Ставить ли cookie сессии флаг `Secure`. Умолч. «да в prod, нет в dev».
#
# **На время теста без домена — `no`**: сайт работает по HTTP на IP, а cookie
# с флагом `Secure` браузер по HTTP просто не сохраняет —
# человек вошёл бы и тут же снова увидел форму входа. Настройка заведена именно
# ради этого случая: иначе пришлось бы поднимать боевую машину как `dev` и
# разом потерять `trust_proxy`, подробность журнала и всё прочее, что режимы
# различает.
#
# Когда появится домен и HTTPS — стереть значение (вернётся умолчание `prod` =
# `yes`). Держать `no` при живом HTTPS не надо: cookie тогда уедет и по
# открытому каналу, если кто-нибудь откроет сайт по `http://`.
KORITSU_COOKIE_SECURE=no

# Верить ли заголовку `X-Forwarded-For`. **За Caddy это обязательно `yes`**:
# иначе все запросы придут с адреса контейнера прокси, и лимит регистраций по
# IP станет лимитом на весь сайт разом. Но и наоборот: с открытым наружу портом
# (dev) это `no`, иначе адрес подделывается одной строкой заголовка.
# Умолч. «да в prod, нет в dev».
KORITSU_TRUST_PROXY=yes

# Кому открыта админка — белый список адресов на прокси: она закрыта и паролем,
# и списком IP на Caddy. Это единственная переменная в файле, которую читает
# не служба, а `docker-compose.yml` → `Caddyfile`: под неё закрыты и
# страница `/admin*`, и `/api/admin/*`, и закрыты они раньше всего прочего.
# Флаг `is_admin` в службе при этом остаётся: список адресов — второй замок, а
# не замена первому.
#
# Значение — CIDR **через пробел**, без кавычек:
#
#     KORITSU_ADMIN_ALLOW=203.0.113.7/32 2001:db8::/64
#
# Через запятую Caddy их не поймёт и откажется подниматься с внятной жалобой в
# журнале — это лучше, чем принять строку и не пустить владельца в его же
# админку. Одиночный адрес пишется маской `/32` (IPv4) или `/128` (IPv6);
# `0.0.0.0/0` означает «всем», и в бою этого писать не надо.
#
# Пусто или строки нет вовсе — петля (`127.0.0.1/32 ::1`), то есть снаружи
# админка закрыта всем. Это умолчание намеренно глухое: файл, который однажды
# выкатят не дочитав, обязан закрывать, а не открывать.
#
# **На время теста можно пустить всех**: строка тогда выглядит как
#
#     KORITSU_ADMIN_ALLOW=0.0.0.0/0 ::/0
#
# и живёт она только здесь, на машине. В репозитории её нет и быть не должно.
# Когда тест кончится — заменить своим адресом. В бою строку **надо**
# заполнить своим адресом — иначе в админку не попасть и владельцу: контейнеры
# приходят к Caddy не с петли, а с адреса сети Docker. На dev
# (`docker-compose.dev.yml`) список уже открыт настежь и этой строкой не
# управляется: порт там и так поднят только на петлю хоста.
KORITSU_ADMIN_ALLOW=

# Домен админки — имя третьего уровня, на котором она живёт: админка вынесена
# на свой домен, а не лежит по `/admin` того же сайта.
#
#     KORITSU_ADMIN_DOMAIN=admin.koritsu.example
#
# Что даёт разделение. У админки свой блок на Caddy: тот же собранный сайт и
# тот же `/api`, но целиком под белым списком адресов (`KORITSU_ADMIN_ALLOW`),
# и свой origin, то есть своя cookie сессии — вошедший в сайт не оказывается
# вошедшим в админку заодно. На основном же имени `/admin` и `/api/admin/*`
# отвечают 404: с домена сайта админки не существует.
#
# Строку читают оба — и `docker-compose.yml` → `Caddyfile` (адрес блока), и
# сама служба: на чужом `Host` маршруты `/api/admin/*` отвечают 404 (за прокси
# имя берётся из `X-Forwarded-Host`, и только при `KORITSU_TRUST_PROXY=yes`).
# Схему и порт писать не обязательно — служба их срезает. Caddy же по имени
# **без** схемы возьмёт сертификат у Let's Encrypt, как и для основного домена;
# с `http://` — не возьмёт (так и стоит в умолчании: просить сертификат на
# несуществующий домен незачем).
#
# Пусто или строки нет — домена у админки нет: снаружи она закрыта совсем
# (Caddy отвечает 404 и на `/admin`, и на `/api/admin/*`), а служба ведёт себя
# как раньше — пускает по флагу `is_admin`. Это рабочее состояние машины без
# домена: `docker compose up` поднимается и без этой строки.
#
# **Настоящее имя живёт только здесь**, как `KORITSU_DOMAIN` выше.
KORITSU_ADMIN_DOMAIN=

# Где слушать. В compose это сказано аргументом (`serve --host 0.0.0.0`), и
# трогать здесь их незачем; оставлены для запуска руками.
# KORITSU_HOST=127.0.0.1
# KORITSU_PORT=8000

# База. Пусто — SQLite в томе (`$KORITSU_DATA_DIR/koritsu.db`).
# Её обязательно забирает резервная копия вместе с файлами: снимок из базы без
# файлов бесполезен ровно так же, как из файлов без базы.
KORITSU_DB_URL=

# ── файлы и квоты ────────────────────────────────────────────────────────────

# 250 МБ на владельца. Считается по каталогам тома, а не файловой системой.
# Она же — квота плана `free`: своего `KORITSU_FREE_QUOTA_BYTES` нет намеренно,
# два числа с одним смыслом обязаны совпадать и однажды разойдутся.
KORITSU_USER_QUOTA_BYTES=262144000

# 10 МБ на один файл. Проверяется до чтения тела в память.
KORITSU_FILE_MAX_BYTES=10485760

# Сколько дней работа лежит в корзине до физической уборки.
KORITSU_TRASH_DAYS=10

# ── аккаунты ─────────────────────────────────────────────────────────────────

# Сессия с продлением.
KORITSU_SESSION_DAYS=30

# Заслон от массовой регистрации: сколько аккаунтов с одного адреса в сутки.
# Работает только при верном `KORITSU_TRUST_PROXY` — см. выше.
KORITSU_REGISTRATIONS_PER_IP_PER_DAY=5

# ── подпроцесс со схемами ────────────────────────────────────────────────────

# Потолки подпроцесса, жующего чужой исходник (блок-схемы, диаграммы UML).
# Машина, где мегабайт склеенного кода не укладывается в минуту, чинится этой
# строкой, а не пересборкой образа. Имя историческое: первым таким подпроцессом
# был разбор материала, уехавший потом в очередь.
KORITSU_PARSE_TIMEOUT_S=60
KORITSU_PARSE_MEMORY_MB=1024

# ── очередь и воркер ─────────────────────────────────────────────────────────

# Слоты: тяжёлых заданий на машину и на одного человека — два на машину, одно
# на пользователя, остальные ждут в очереди.
KORITSU_JOB_SLOTS=2
KORITSU_JOBS_PER_USER=1

# Как часто воркер заглядывает в таблицу, когда работы нет. Секунды, дробное.
KORITSU_WORKER_POLL_S=1.0

# Потолки одного задания. Полчаса — столько, чтобы отчёт на два десятка тегов с
# медленным поставщиком успел, а зациклившийся обработчик — нет. По этому же
# сроку воркер признаёт чужое задание потерянным.
KORITSU_JOB_TIMEOUT_S=1800
KORITSU_JOB_MEMORY_MB=2048

# Сколько дней хранится законченное задание. Считается от последнего обращения,
# а не от конца работы: отчёт, который открывают раз в месяц, живёт.
KORITSU_JOBS_RETENTION_DAYS=90

# Как часто поток событий (SSE) заглядывает в базу. Секунды, дробное.
KORITSU_SSE_POLL_S=0.5

# Сколько живёт одно соединение потока, прежде чем служба закроет его сама.
# Час — больше самого долгого задания (`KORITSU_JOB_TIMEOUT_S`), поэтому поток
# задания успевает дожить до конца работы; потоку на пользователя это просто
# потолок, после которого браузер переподключается с `Last-Event-ID`.
KORITSU_SSE_MAX_S=3600

# ── модель и расход ──────────────────────────────────────────────────────────

# Справочник планов. У плана два числа: месячный потолок расхода во внутренних
# единицах и квота места на томе. **Все числа временные**: они определятся
# вместе с ценами подписки.
# Какие вообще бывают планы — `packages/api/runs/limits.ПЛАНЫ`, а не этот файл:
# план появляется вместе с кодом, который его обслуживает.
#
# У `free` квота своя не заводится: она и есть `KORITSU_USER_QUOTA_BYTES` выше.
KORITSU_FREE_MONTHLY_UNITS=2000000
KORITSU_PRO_MONTHLY_UNITS=20000000
KORITSU_PRO_QUOTA_BYTES=1048576000
KORITSU_TEAM_MONTHLY_UNITS=100000000
KORITSU_TEAM_QUOTA_BYTES=5242880000

# Цены наших инструментов в тех же единицах: расход считается за наши
# инструменты и мощности, а не за токены поставщика. Списывается цена вида
# при захвате задания воркером; токены поставщика в неё не входят — они живут в
# журнале проекта. **Все числа временные**, до цен подписки; осмысленно в них
# пока только соотношение. Исключение — `KORITSU_PRICE_BUILD`: за Word → PDF
# назначена единица, потому что превью собранного документа человек жмёт
# помногу раз за работу.
KORITSU_PRICE_PARSE=10
KORITSU_PRICE_EXPORT=20
KORITSU_PRICE_BUILD=1
KORITSU_PRICE_FILL_TAG=100
KORITSU_PRICE_FILL_REPORT=1000
KORITSU_PRICE_AGENT=2000
KORITSU_PRICE_KADAI_RUN=5000
KORITSU_PRICE_KADAI_REWORK=1000
KORITSU_PRICE_BOARD_CHECK=300
# Проба очереди бесплатна и должна такой остаться: платная проверка «жив ли
# воркер» — это проверка, которую перестают делать.
KORITSU_PRICE_PROBE=0

# Предпросмотров схем в минуту на человека. Единственный тяжёлый маршрут,
# который любой вошедший дёргает без проекта и без роли. Счётчик — в памяти
# процесса, поэтому при двух процессах API настоящий потолок вдвое больше.
KORITSU_PREVIEW_PER_MINUTE=30

# Общих ключей поставщиков у службы нет и настройки для них тоже нет. Прогон
# идёт на ключе того, кто его завёл: человек кладёт ключ через сайт, ключ
# шифруется `KORITSU_SECRET` и расшифровывается только в подпроцессе задания.
# Так расход виден там, где его можно проверить, — в кабинете самого человека у
# поставщика. Переменная `KORITSU_PROVIDER_KEY_<ПРЕСЕТ>` когда-то работала и
# теперь не читается ничем: оставленная в `.env`, она ничего не включит.

# Подмена адреса поставщика — только для стенда сквозных проверок сайта
# (`web/e2e/`), где вместо настоящей модели отвечает поддельный сервер.
# Переменная называется с именем пресета на конце (в настройках службы это одно
# поле-словарь KORITSU_LLM_BASE_URLS):
#
#     KORITSU_LLM_BASE_URL_DEEPSEEK=http://127.0.0.1:8016
#
# Здесь она закомментирована и должна такой остаться: применяется она ТОЛЬКО при
# KORITSU_ENV=dev, а в prod читается, не применяется и пишет предупреждение в
# журнал при старте. Причина запрета проста — этой строкой переписывается адрес,
# по которому уезжает ключ человека.

# ── ассемблер ────────────────────────────────────────────────────────────────

# Модуль «Ассемблер» собирает программу настоящими TASM и TLINK (Borland) в
# DOSBox-X и снимает трассу отладчиком DebugX. DOSBox-X и DebugX стоят в образе;
# TASM и TLINK проприетарные и в репозиторий и образ не входят — их каталог
# кладётся на машину и монтируется томом только для чтения.
#
# Что положить в каталог (имена без учёта регистра):
#
#     TASM.EXE      ассемблер (TASM 4.x или 5.x, 16-битный, не TASM32)
#     TLINK.EXE     компоновщик (TLINK 7.x)
#     RTM.EXE,      если их требует ваша версия: TLINK 7 и TASM 5 работают
#     DPMI16BI.OVL  под DPMI и без этих двух не запускаются
#
# Путь на хосте читает `docker-compose.yml` (умолч. `./asm-tools` рядом с ним);
# путь внутри контейнера — служба. Их два, потому что это разные машины: каталог
# хоста монтируется в `/opt/asm-tools`, и служба видит только второй.
# KORITSU_ASM_TOOLS_HOST=./asm-tools
KORITSU_ASM_TOOLS=/opt/asm-tools

# Версия TASM, которая лежит в корне каталога. Несколько версий кладутся
# подкаталогами с именем версии (`4.1/`, `5.0/`) и находятся сами; тогда корень
# не нужен. Умолчание — 4.1.
# KORITSU_ASM_TASM_VERSION=4.1

# DOSBox-X и DebugX: трогать незачем, умолчания совпадают с образом.
# KORITSU_ASM_DOSBOX=dosbox-x
# KORITSU_ASM_DEBUGX=/opt/asm/debugx/DEBUGX.COM

# Потолок одного прогона — на всё сразу: сборку, трассу и перезапуски, которыми
# подбирается ввод программы (по одному на каждое чтение stdin). Для ориентира:
# примерно 6 с на 100 000 шагов DebugX в DOSBox-X, так что 90 секунд хватает на
# потолок в 500 000 шагов с запасом на перезапуски ради ввода.
KORITSU_ASM_TIMEOUT_S=90

# Потолок лимита шагов, который человек может выставить у программы.
KORITSU_ASM_STEP_LIMIT_MAX=500000

# ── ассемблер: MinGW x64 ─────────────────────────────────────────────────────

# Режим «MinGW x64» собирает программу GNU as/ld в воркере, а исполняет её под Wine
# отдельный контейнер `asm-runner` (см. `docker-compose.yml`): код студента там
# выполняется на процессоре по-настоящему, и в воркере с томом данных и этими
# секретами ему не место. Воркер и исполнитель говорят через общий том очереди;
# путь к нему внутри `worker` и `api` — здесь. Пусто — трассы MinGW x64 нет
# (сборка работает, прогон отвечает «трассировщик не установлен»).
KORITSU_ASM_MINGW_QUEUE=/queue

# `as`, `ld` и `libkernel32.a` стоят в образе; трогать незачем.
# KORITSU_ASM_MINGW_PREFIX=x86_64-w64-mingw32-
# KORITSU_ASM_MINGW_BIN=
# KORITSU_ASM_MINGW_LIB=/usr/x86_64-w64-mingw32/lib

# Потолок лимита шагов программы MinGW x64 (не больше 200 000). Шаг под
# трассировщиком дороже шага DebugX, а таймаут прогона общий с TASM.
# KORITSU_ASM_MINGW_STEP_LIMIT_MAX=20000

# Настройки самого исполнителя. Их читает `docker-compose.yml` и передаёт в
# `asm-runner` отдельными переменными: `.env` целиком в исполнитель не попадает.
#
# Прогонов одновременно. Каждый — процесс Wine и wineserver; контейнеру дан
# 1 ГБ памяти и одно ядро.
# KORITSU_ASM_RUNNER_SLOTS=2
# Потолок времени одного прогона в исполнителе, что бы ни попросил воркер.
# KORITSU_ASM_RUNNER_TIMEOUT_MAX_S=300
# Задание старше этого удаляется из очереди, даже если его никто не забрал.
# KORITSU_ASM_RUNNER_JOB_TTL_S=900

# Показывать модуль, даже если TASM и TLINK не найдены (для разработки сайта:
# прогоны тогда отвечают 503). В бою — пусто.
# KORITSU_ASM_SHOW=

# ── тренажёр карточек ────────────────────────────────────────────────────────

# Потолок файла набора (JSON, CSV, TSV) и текста черновика, байт. 5 МБ — это
# тысячи карточек с формулами.
# KORITSU_CARDS_FILE_MAX_BYTES=5242880

# Черновик живёт столько дней с последней записи; черновиков на человека не больше
# этого числа, сверх него уходят самые старые.
# KORITSU_CARDS_DRAFT_DAYS=7
# KORITSU_CARDS_DRAFTS_MAX=50

# Генерация агентом: карточек и файлов за одно задание, знаков текста с одного
# файла. Всё это уезжает в промпт и оплачивается человеком. Цена задания
# `cards_generate` — та же, что у ответа агента в чате доски (KORITSU_PRICE_BOARD_CHECK).
# KORITSU_CARDS_GENERATE_MAX=200
# KORITSU_CARDS_MATERIALS_MAX=20
# KORITSU_CARDS_MATERIAL_CHARS_MAX=200000

# Сколько часов незаконченный заход предлагается продолжить.
# KORITSU_CARDS_RESUME_HOURS=12
