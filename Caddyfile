# Caddy — единственный, кто смотрит наружу: TLS, сайт статикой, `/api/` внутрь.
#
# Домен — заглушка `koritsu.example` (решение владельца §11). Настоящий ставится
# заменой этой строки и `KORITSU_BASE_URL` в `.env`; больше нигде домен не
# написан. `koritsu.example` — из зарезервированной зоны `.example`, то есть
# заведомо ничей: забытый в бою, он не уведёт запросы к чужому серверу.
#
#     Кто куда ходит
#     --------------
#
#   /api/v1/*     → api           мимо Anubis (§11: внешние ключи, не браузеры)
#   /api/*        → api           сайт со своей cookie-сессией
#   /health       → api           проба для прокси и для человека
#   /api/admin/*  → api           только с адресов белого списка
#   /admin*       → статика       то же, для будущей страницы админки
#   всё остальное → anubis → caddy:8080 → /srv/web (сайт на Vite)
#
# Anubis стоит **перед статикой, а не перед API**, и это не мелочь. Проверка
# работой — заслон от массового обхода страниц браузером-ботом; внешний ключ,
# приходящий на `/api/v1/`, браузером не является вовсе и решить задачу на хеш
# не может. Пустив `/api/v1/` через Anubis, мы получили бы внешний API, не
# работающий ни у кого (§11: «`/api/v1/` с токеном идёт мимо Anubis»).
#
# Сайта в образе нет: Vite собирает `web/dist` снаружи, compose монтирует его
# в `/srv/web` (§11: «отдельного контейнера нет»).

{
	# Почта для Let's Encrypt: на неё приходит письмо, если сертификат не
	# продлился. Заменить на настоящую вместе с доменом.
	email admin@koritsu.example
}

koritsu.example {
	encode zstd gzip

	# ── внешний вход: мимо Anubis ───────────────────────────────────────────
	@v1 path /api/v1/*
	handle @v1 {
		reverse_proxy api:8000
	}

	# ── админка: белый список IP на прокси (§3, §11) ────────────────────────
	# Заготовка: адреса ставит владелец. Пока в списке только петля, то есть
	# снаружи админка не открыта никому — и это правильное умолчание для
	# файла, который однажды выкатят, не дочитав.
	@admin path /api/admin/* /admin /admin/*
	handle @admin {
		@allowed remote_ip 127.0.0.1/32 ::1
		handle @allowed {
			@admin_api path /api/*
			handle @admin_api {
				reverse_proxy api:8000
			}
			handle {
				root * /srv/web
				try_files {path} /index.html
				file_server
			}
		}
		# Не 403: чужому знать, что админка тут есть, незачем (§3).
		handle {
			respond 404
		}
	}

	# ── сайт: своя cookie-сессия ────────────────────────────────────────────
	@api path /api/* /health
	handle @api {
		reverse_proxy api:8000
	}

	# ── всё остальное: страницы сайта, через проверку работой ───────────────
	handle {
		reverse_proxy anubis:8923
	}
}

# Внутренний вход для Anubis: прошедших проверку он шлёт сюда, и здесь лежит
# сайт. Отдельным блоком, а не «Anubis сразу в файлы», потому что раздавать
# статику — работа Caddy: у Anubis нет ни сжатия, ни `try_files`, ни кэша.
#
# Порт внутренний: наружу он не опубликован (`docker-compose.yml` не даёт ему
# `ports:`), и попасть сюда можно только из сети compose.
:8080 {
	encode zstd gzip
	root * /srv/web
	# SPA: адрес вроде `/projects/<uuid>` файлом на диске не является, и
	# отдавать на него 404 значило бы ломать перезагрузку страницы. Всё, чего
	# нет файлом, отвечает `index.html`, а маршрут разбирает сам сайт.
	try_files {path} /index.html
	file_server
}
