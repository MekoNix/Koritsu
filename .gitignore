# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Окружения
.venv
.env
# Местный довесок к compose: порт, за которым стоит машина, и её особенности
# (стенд без домена — Caddy на своём порту, кука Anubis без `Secure`). Compose
# подхватывает его сам, и в репозиторий ему нельзя ровно поэтому: он про машину,
# а не про продукт.
docker-compose.override.yml

# Выход тестов uml_generator (пишутся рядом с тестами для глаз)
tests/uml_generator/*.drawio
tests/uml_generator/*.xml
tests/uml_generator/*.png

# IDE / OS
.vscode/
.idea/
.DS_Store

# Claude Code
**/.claude/settings.local.json
.claude/worktrees/
.pytest_cache/

# локальный скрипт коммита, в репозиторий не идёт
commit.sh

# TASM и TLINK для модуля «Ассемблер»: проприетарные, живут только на машине
asm-tools/

# записки для контекста, в репозиторий не идут
ref

# локальные правила для агентов, в репозиторий не идут
CLAUDE.local.md
