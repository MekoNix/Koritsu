# Что не уезжает в контекст сборки. Смысл файла не в размере образа, а в двух
# вещах, которые не должны попасть в слой: секреты и чужое состояние.
#
# `.env` — первым и главным (§7: секреты живут на хосте, вне репозитория и вне
# образа). Образ уезжает в GHCR, и `.env`, попавший в слой, — это ключ, который
# читается `docker history` у любого, кто образ скачал.

# ── секреты и локальное состояние ───────────────────────────────────────────
.env
.env.*
!.env.example
data/
*.db
*.sqlite3

# ── история и служебное ─────────────────────────────────────────────────────
.git
.gitignore
.github
.claude
.editorconfig

# ── то, что собирается заново ───────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ── то, чего в образе нет по решению ────────────────────────────────────────
# Тесты: образ поднимает службу, а не проверяет её; прогон идёт до сборки.
tests/
# Сайт: Vite собирает `web/dist` снаружи, Caddy отдаёт его статикой (§11), и
# внутрь образа он не попадает вовсе.
web/
# Записки и планы: их читает человек в репозитории, а не служба в контейнере.
ref/
status.md
CHANGELOG.md
Dockerfile
docker-compose*.yml
Caddyfile
