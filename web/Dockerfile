# Koritsu, сайт: многоступенчатая сборка — Node живёт только внутри сборки, а
# наружу уезжают одни файлы.
#
#   ступень build   node:22-alpine, pnpm через corepack, `pnpm build` → /app/dist
#   ступень итог    caddy:2-alpine + /srv/web: ни Node, ни pnpm, ни исходников,
#                   ни `node_modules` (это сотни мегабайт и весь чужой код)
#
# Контекст сборки — каталог `web/` (`docker-compose.yml`: `context: ./web`),
# поэтому пути ниже отсчитываются от него: `package.json`, а не `web/package.json`.
#
# Почему итог — Caddy, а не `scratch` с одними файлами. Файлы кому-то надо
# отдавать, и отдаёт их у нас Caddy. Образ из `scratch` пришлось бы возить в
# Caddy через общий том, а том кто-то должен заполнить — значит третий,
# одноразовый контейнер с `cp` (в `scratch` нет ни `cp`, ни shell вообще), плюс
# сам том, плюс порядок запуска, плюс ответ на вопрос «что будет со старыми
# файлами в томе при выкате». Здесь всё это — две строки `COPY` в тот самый
# образ, который сайт и раздаёт: каждый выкат приносит ровно ту статику, что
# собрана из этого кода, а не ту, что осталась в томе с прошлого раза.
#
# Собирается это как часть общего выката:
#
#     docker compose up -d --build
#
# `Caddyfile` в образ **не** попадает: он остаётся файлом на хосте и монтируется
# (`./Caddyfile:/etc/caddy/Caddyfile:ro`). Так правка домена или белого списка
# адресов не требует пересборки сайта — а она у нас самая долгая.

# ── ступень сборки ───────────────────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app

# Playwright в devDependencies тянет при установке браузеры — сотни мегабайт,
# нужные только для `pnpm e2e`. Здесь идёт сборка, браузер ей не нужен; типы
# `@playwright/test` (их требует `tsc` — `tsconfig.json` включает `e2e/`)
# ставятся и без загрузки самих браузеров.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    CI=1

# Зависимости — отдельным слоем и до кода: манифест меняется раз в месяц, код —
# каждый день, и слитые в один слой они означали бы полную переустановку на
# каждую правку строки в компоненте.
#
# pnpm берётся не установкой, а corepack: версия записана в `package.json`
# (`packageManager: pnpm@9.15.9`), и corepack поднимет ровно её. Установленный
# `npm i -g pnpm` разошёлся бы с той, которой собран `pnpm-lock.yaml`.
COPY package.json pnpm-lock.yaml ./
RUN corepack enable \
    && pnpm install --frozen-lockfile

# `--frozen-lockfile` — не придирка: без него pnpm молча дообновит зависимости,
# и в бой уедет сборка из кода, которого никто не проверял. Расхождение
# `package.json` с `pnpm-lock.yaml` обязано ронять сборку здесь, а не удивлять
# на живой машине.

COPY . .

# Префикс пути, под которым живёт сайт (адрес без домена — IP плюс случайная
# строка, чтобы сайт не нашли перебором). Приезжает из
# compose (`build.args.VITE_BASE_PATH`), а туда — из `.env`; в репозитории его
# нет и быть не должно.
#
# Аргументом сборки, а не переменной запуска, потому что Vite вписывает его в
# `index.html` и во все ссылки на `assets/` **на сборке**: поменять префикс у
# готового образа нельзя, только пересобрать. Умолчание `/` — сайт в корне, то
# есть ровно то, что было до префиксов.
ARG VITE_BASE_PATH=/
ENV VITE_BASE_PATH=${VITE_BASE_PATH}

# `pnpm build` — это `tsc --noEmit && vite build`: тот же ход, что у человека
# в `web/README.md`. Типы проверяются здесь намеренно — образ, собранный из
# кода, который не сходится по типам, не нужен никому.
RUN pnpm build

# ── итог: только файлы, отданные Caddy ───────────────────────────────────────
# Ни Node, ни pnpm, ни исходников: всё, что здесь есть сверх базового Caddy, —
# каталог собранной статики.
FROM caddy:2-alpine

COPY --from=build /app/dist /srv/web
